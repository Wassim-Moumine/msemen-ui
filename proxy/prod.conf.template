server {
    listen 80;
    server_name msemen.${DOMAIN} analytics.${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name msemen.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/msemen/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/msemen/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://web:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    server_name analytics.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/msemen/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/msemen/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://matomo:80;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
